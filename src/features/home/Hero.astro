---
import { Image } from "astro:assets";
import heroPhoto from "../../assets/home/hero.png";
import cardTerapia from "../../assets/home/card-terapia.jpg";
import cardAlquiler from "../../assets/home/service-alquiler.jpeg";
import cardGrupal from "../../assets/home/card-grupal.jpeg";

const cards = [
  {
    title: "Servicios de terapia psicológica Online y Presencial",
    photo: cardTerapia,
    alt: "Sala de terapia con materiales de arte y plantas",
  },
  {
    title: "Alquiler de consultorios para profesionales en salud mental",
    photo: cardAlquiler,
    alt: "Grupo de personas reunidas en una sala del consultorio con una reja blanca en la ventana",
  },
  {
    title: "Servicios de acompañamiento psicológico grupal",
    photo: cardGrupal,
    alt: "Taller grupal de arcilla en Casa Ánima",
  },
];
---

<section class="hero">
  <h1>
    En Casa Ánima, cada proceso es un viaje de autoconocimiento y cuidado desde
    la calidez y el respeto.
  </h1>
  <Image
    src={heroPhoto}
    alt="Dos integrantes del equipo de Casa Ánima tomando café"
    width={640}
  />
</section>

<section class="cards">
  {cards.map(({ title, photo, alt }) => (
    <article>
      <Image src={photo} alt={alt} width={400} height={300} />
      <h2>{title}</h2>
    </article>
  ))}
</section>

<style>
  .hero {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: 3rem 1.5rem;
    background: var(--color-background);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-slate);
  }

  .hero img {
    justify-self: center;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    padding: 2rem 1.5rem;
    background: linear-gradient(
      to bottom,
      var(--color-background) 0 3rem,
      var(--color-mist) 3rem
    );
  }

  article {
    display: flex;
    flex-direction: column-reverse;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--color-teal);
    text-align: center;
  }

  article h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 400;
    color: #ffffff;
  }

  article img {
    width: 70%;
    align-self: center;
    object-fit: cover;
    border-radius: 1rem;
  }

  @media (min-width: 640px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      padding: 3rem 4rem;
    }
  }
</style>

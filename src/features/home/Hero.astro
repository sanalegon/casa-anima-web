---
import { Image } from "astro:assets";
import heroPhoto from "../../assets/home/hero.png";
import cardTerapia from "../../assets/home/card-terapia-sala.png";
import cardAlquiler from "../../assets/home/card-alquiler-consultorio.png";
import cardGrupal from "../../assets/home/card-grupal-formacion.png";

const cards = [
  {
    title: "Servicios de terapia psicológica Online y Presencial",
    photo: cardTerapia,
    alt: "Sala de terapia con sofá azul, un peluche y pinturas sobre la mesa",
  },
  {
    title: "Alquiler de consultorios para profesionales en salud mental",
    photo: cardAlquiler,
    alt: "Consultorio con una butaca gris, una estantería turquesa y un mural de colores en la pared",
  },
  {
    title: "Servicios de acompañamiento psicológico grupal",
    photo: cardGrupal,
    alt: "Grupo de personas sonriendo sentadas en gradas azules",
  },
];
---

<section class="hero">
  <h1>
    En Casa Ánima, cada proceso es un viaje de autoconocimiento y cuidado desde
    la calidez y el respeto.
  </h1>
  <Image
    src={heroPhoto}
    alt="Dos integrantes del equipo de Casa Ánima tomando café"
    width={640}
  />
</section>

<section class="cards">
  {cards.map(({ title, photo, alt }) => (
    <article>
      <h2>{title}</h2>
      <Image src={photo} alt={alt} width={400} height={300} />
    </article>
  ))}
</section>

<style>
  .hero {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: 3rem 1.5rem;
    background: var(--color-background);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-slate);
  }

  .hero img {
    justify-self: center;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    padding: 2rem 1.5rem;
    background: linear-gradient(
      to bottom,
      var(--color-background) 0 4rem,
      var(--color-mist) 4rem calc(100% - 4rem),
      var(--color-background) calc(100% - 4rem)
    );
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem 1.25rem 2rem;
    background: var(--color-teal) url("../../assets/decor/texture-teal.png")
      center / cover;
    text-align: center;
  }

  article h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.3;
    color: #ffffff;
    text-wrap: balance;
  }

  article img {
    width: 70%;
    height: auto;
    aspect-ratio: 4 / 3;
    align-self: center;
    object-fit: cover;
    border-radius: 1rem;
  }

  @media (min-width: 768px) {
    article h2 {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 640px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      padding: 3rem max(4rem, calc((100% - 72rem) / 2));
    }
  }
</style>

---
import {
  address,
  adviserWhatsappUrl,
  email,
  phoneLabel,
  whatsappUrl,
} from "../../shared/contact";

const socials = [
  {
    name: "Instagram",
    href: "https://www.instagram.com/casaanima_psicologia",
    icon: "M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm5.5-1.5h.01",
  },
  {
    name: "Facebook",
    href: "https://www.facebook.com/p/Casa-Ánima-Consultorios-61568582250827/",
    icon: "M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5a.5.5 0 0 1 .5-.5Z",
  },
  {
    name: "WhatsApp",
    href: adviserWhatsappUrl,
    icon: "M12 3a8 8 0 0 0-6.9 12L4 20l5.2-1.1A8 8 0 1 0 12 3Zm-3 5c.5 3 2.5 5.5 6 7l1.5-1.5-2-1-1 .8c-1-.5-1.8-1.3-2.3-2.3l.8-1-1-2Z",
  },
];
---

<footer>
  <h2>¡Nos vemos en Casita!</h2>
  <ul>
    <li>
      <a href={whatsappUrl}>{phoneLabel}</a>
    </li>
    <li>
      <a href={`mailto:${email}`}>{email}</a>
    </li>
    <li>{address}</li>
  </ul>
  <ul class="socials">
    {socials.map(({ name, href, icon }) => (
      <li>
        <a
          href={href}
          aria-label={name}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d={icon} />
          </svg>
        </a>
      </li>
    ))}
  </ul>
</footer>

<style>
  footer {
    padding: 2.5rem 1.5rem;
    background: var(--color-teal);
    color: #ffffff;
    text-align: center;
  }

  h2 {
    margin: 0 0 1rem;
    color: #ffffff;
  }

  ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: #ffffff;
  }

  .socials {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    margin-top: 1.5rem;
  }

  svg {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke: #ffffff;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

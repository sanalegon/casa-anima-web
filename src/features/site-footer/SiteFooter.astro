---
import { Image } from "astro:assets";
import leaf from "../../assets/decor/simple-green-leaf.png";
import blob from "../../assets/decor/blob.png";
import swirl from "../../assets/decor/swirl.png";
import cloud1 from "../../assets/decor/cloud-1.png";
import cloud2 from "../../assets/decor/cloud-2.png";
import cloud3 from "../../assets/decor/cloud-3.png";
import instagramIcon from "../../assets/social/instagram.jpg";
import facebookIcon from "../../assets/social/facebook.webp";
import tiktokIcon from "../../assets/social/tik-tok.webp";
import whatsappIcon from "../../assets/social/whatsapp.webp";
import branchLeft from "../../assets/decor/branch-left.png";
import branchRight from "../../assets/decor/branch-right.png";
import logo from "../../assets/brand/logo-casa-anima.png";
import {
  address,
  adviserWhatsappUrl,
  email,
  phoneLabel,
  whatsappUrl,
} from "../../shared/contact";

const socials = [
  {
    name: "Instagram",
    href: "https://www.instagram.com/casaanima_psicologia",
    icon: instagramIcon,
  },
  {
    name: "Facebook",
    href: "https://www.facebook.com/p/Casa-Ánima-Consultorios-61568582250827/",
    icon: facebookIcon,
  },
  { name: "TikTok", href: undefined, icon: tiktokIcon },
  { name: "WhatsApp", href: adviserWhatsappUrl, icon: whatsappIcon },
];

const cloudImages = [cloud1, cloud2, cloud3];

const clouds = [
  { x: 0, y: 2, w: 17.7, opacity: 1, mobile: true },
  { x: 26.8, y: 11.8, w: 15, opacity: 0.55, mobile: false },
  { x: 66.8, y: 10.8, w: 13, opacity: 1, mobile: true },
  { x: 86.1, y: 10.4, w: 14, opacity: 0.55, mobile: false },
  { x: 18, y: 30, w: 13, opacity: 1, mobile: true },
  { x: 77.7, y: 37.6, w: 15, opacity: 1, mobile: true },
  { x: 94, y: 52, w: 10, opacity: 0.55, mobile: false },
  { x: 68.4, y: 56.4, w: 15, opacity: 0.55, mobile: false },
  { x: 7, bottom: 10.2, w: 15, opacity: 1, mobile: true },
];
---

<footer>
  <Image class="branch branch-left" src={branchLeft} alt="" height={208} />
  <Image class="branch branch-right" src={branchRight} alt="" height={208} />
  {clouds.map(({ x, y, bottom, w, opacity, mobile }, index) => (
    <Image
      class={mobile ? "cloud" : "cloud extra"}
      src={cloudImages[index % cloudImages.length]}
      alt=""
      width={256}
      style={`--x: ${x}%; --y: ${y === undefined ? "auto" : `${y}%`}; --b: ${bottom === undefined ? "auto" : `${bottom}vw`}; --w: ${w}%; --o: ${opacity}`}
    />
  ))}
  <Image class="blob blob-left" src={blob} alt="" width={512} />
  <Image class="blob blob-right" src={blob} alt="" width={512} />
  <Image class="swirl swirl-left" src={swirl} alt="" width={348} />
  <Image class="swirl swirl-right" src={swirl} alt="" width={348} />
  <ul class="socials">
    {socials.map(({ name, href, icon }) => (
      <li>
        {href ? (
          <a href={href} target="_blank" rel="noopener noreferrer">
            <Image src={icon} alt={name} width={224} />
          </a>
        ) : (
          <Image src={icon} alt={name} width={224} />
        )}
      </li>
    ))}
  </ul>
  <h2 class="visually-hidden">¡Nos vemos en Casita!</h2>
  <div class="crest">
    <svg viewBox="0 0 400 232" aria-hidden="true" focusable="false">
      <defs>
        <path id="footer-arc" d="M 66.1 193.6 A 136 136 0 1 1 333.9 193.6" />
      </defs>
      <text text-anchor="middle">
        <textPath href="#footer-arc" startOffset="50%">
          ¡Nos vemos en Casita!
        </textPath>
      </text>
    </svg>
    <Image class="logo" src={logo} alt="" width={400} />
  </div>
  <div class="bar">
    <div class="info">
      <p>
        <span class="phone">
          <span>Más información</span>
          <a href={whatsappUrl}>{phoneLabel}</a>
        </span>
        <span aria-hidden="true">|</span>
        <span>{address}</span>
      </p>
      <p>
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    </div>
    <Image class="leaf" src={leaf} alt="" width={254} />
  </div>
</footer>

<style>
  footer {
    position: relative;
    overflow: hidden;
    display: grid;
    justify-items: center;
    padding: 2.5rem 0 0;
    background-color: #ffffff;
    color: var(--color-teal);
    text-align: center;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .crest {
    position: relative;
    z-index: 1;
    width: min(21rem, 100%);
  }

  .crest > svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .socials {
    position: relative;
    z-index: 4;
    gap: 1.5rem;
    margin: 0 0 1rem;
  }

  .socials img {
    display: block;
    width: 4rem;
    height: auto;
  }

  .socials img[alt="Instagram"] {
    border-radius: 22%;
  }

  .branch {
    position: absolute;
    top: -1rem;
    height: 6rem;
    width: auto;
    z-index: 4;
    pointer-events: none;
  }

  .branch-left {
    left: -0.5rem;
  }

  .branch-right {
    right: -0.5rem;
  }

  .cloud {
    position: absolute;
    z-index: 0;
    left: var(--x);
    top: var(--y);
    bottom: var(--b);
    width: clamp(4rem, var(--w), 13rem);
    height: auto;
    opacity: var(--o);
    pointer-events: none;
  }

  .extra {
    display: none;
  }

  .crest text {
    fill: var(--color-sea);
    font-family: var(--font-open-sans);
    font-weight: 400;
    font-size: 29.7px;
  }

  .logo {
    position: absolute;
    top: 54%;
    left: 50%;
    width: 60%;
    height: auto;
    transform: translate(-50%, -50%);
    mix-blend-mode: multiply;
  }

  ul {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    margin: 1rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  a {
    color: inherit;
  }

  .bar {
    position: relative;
    justify-self: start;
    width: 94%;
    margin-left: 3%;
  }

  .info {
    position: relative;
    z-index: 3;
    box-sizing: border-box;
    width: 100%;
    padding: 1.25rem 1.5rem;
    background: rgb(255 255 255 / 0.75);
    box-shadow: 0 -2px 12px rgb(19 75 99 / 0.08);
    color: var(--color-sea);
    font-family: var(--font-open-sans);
    font-size: 16.2px;
    font-weight: 700;
  }

  .info a {
    color: inherit;
    text-decoration: none;
  }

  .info a:hover,
  .info a:focus-visible {
    text-decoration: underline;
  }

  .info p {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
  }

  .phone {
    display: inline-flex;
    justify-content: center;
    gap: 0 0.5rem;
  }

  .info p + p {
    margin-top: 0.25rem;
  }

  .blob {
    position: absolute;
    z-index: 1;
    height: auto;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  .blob-left {
    --size: max(35vw, 11rem);
    left: 0;
    bottom: calc(var(--size) * -0.45);
    width: var(--size);
    transform: rotate(70deg);
  }

  .blob-right {
    width: 30vw;
    left: 68%;
    bottom: -12vw;
    transform: rotate(10);
  }

  .swirl {
    position: absolute;
    z-index: 2;
    height: auto;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  .swirl-left {
    width: 17vw;
    left: 13%;
    bottom: -9vw;
    transform: rotate(-10deg);
  }

  .swirl-right {
    width: 18vw;
    left: 66%;
    bottom: -7vw;
    transform: rotate(-70deg);
  }

  .leaf {
    position: absolute;
    z-index: 2;
    left: 72%;
    bottom: 25%;
    height: 6rem;
    width: auto;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  @media (min-width: 48rem) {
    .crest {
      width: 26.6rem;
    }

    .extra {
      display: block;
    }

    .socials {
      width: min(55%, 60rem);
      justify-content: space-between;
      gap: 0;
    }

    .branch {
      top: -4rem;
      height: 18rem;
    }

    .branch-left {
      left: 3%;
    }

    .branch-right {
      right: 3%;
    }

    .socials img {
      width: 7rem;
    }

    .info p:first-child {
      flex-direction: row;
      justify-content: center;
      gap: 0.75rem;
    }

    .info {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 8.85vw;
    }

    .bar {
      width: 87%;
      margin-left: 8%;
    }

    .leaf {
      left: 85%;
      bottom: 0%;
      height: 150%;
    }
  }
</style>

---
import { Image } from "astro:assets";
import logo from "../../assets/brand/logo-casa-anima.png";
import texture from "../../assets/decor/texture-teal.png";
import branchLeft from "../../assets/decor/branch-left.png";
import branchRight from "../../assets/decor/branch-right.png";

const links = [
  { label: "Inicio", href: "/" },
  { label: "Quiénes somos", href: "/#quienes-somos" },
  { label: "Servicios", href: "/#servicios" },
  { label: "Equipo", href: "/#equipo" },
  { label: "Contáctanos", href: "/#contacto" },
];
---

<header>
  <Image class="branch branch-left" src={branchLeft} alt="" height={240} />
  <Image class="branch branch-right" src={branchRight} alt="" height={240} />
  <a class="logo" href="/">
    <Image src={logo} alt="Casa Ánima" height={160} />
  </a>
  <nav aria-label="Principal">
    <Image class="texture" src={texture} alt="" width={1600} />
    <ul>
      {links.map(({ label, href }) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  header {
    position: relative;
    overflow-x: clip;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 0 3.5rem;
    background: #ffffff;
    z-index: 1;
  }

  .branch {
    position: absolute;
    top: -4.5rem;
    z-index: 0;
    width: auto;
    height: 14.5rem;
    pointer-events: none;
  }

  .branch-left {
    left: -0.5rem;
  }

  .branch-right {
    right: -1.5rem;
  }

  .logo {
    position: relative;
    z-index: 1;
    display: flex;
    mix-blend-mode: multiply;
  }

  .logo img {
    width: auto;
    height: 9.5rem;
  }

  nav {
    position: relative;
    z-index: 1;
    overflow: hidden;
    width: 100%;
    padding: 1.5rem 1.5rem;
    border-radius: 2.5rem;
    background: var(--color-teal);
  }

  .texture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  ul {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  nav a {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
  }

  @media (min-width: 768px) {
    header {
      flex-direction: row;
      gap: 0.5rem;
      padding: 0 8rem;
    }

    .branch {
      top: -6rem;
      height: 24rem;
    }

    .branch-left {
      left: -5.1rem;
    }

    .branch-right {
      right: -2.5rem;
    }

    .logo img {
      height: 13rem;
    }

    nav {
      flex: 1;
      width: auto;
      padding: 2.5rem 2rem;
      border-radius: 4rem;
    }
  }
</style>

---
import { Image } from "astro:assets";
import logo from "../../assets/logo-blue-backscreen.png";

const links = [
  { label: "Inicio", href: "/" },
  { label: "Quiénes somos", href: "/#quienes-somos" },
  { label: "Servicios", href: "/#servicios" },
  { label: "Equipo", href: "/#equipo" },
  { label: "Contáctanos", href: "/#contacto" },
];
---

<header>
  <a href="/">
    <Image src={logo} alt="Casa Ánima" height={64} />
  </a>
  <nav aria-label="Principal">
    <ul>
      {links.map(({ label, href }) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-teal);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
  }

  @media (min-width: 640px) {
    header {
      justify-content: flex-start;
      gap: 4rem;
      padding-inline: 4rem;
    }
  }
</style>
